
# VARIABLES DE ENTORNO REQUERIDAS

# Ruta al archivo JSON de credenciales de cuenta de servicio de Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/tu/service-account-key.json

# ID del Proyecto de Google Cloud
GOOGLE_CLOUD_PROJECT=tu-proyecto-id

# URL de PostgreSQL para registrar reportes en reports_sent
# Formato Cloud SQL:
# postgresql://usuario:password@/database?host=/cloudsql/proyecto:region:instancia
DATABASE_URL=postgresql://usuario:password@/simbyp_db?host=/cloudsql/tu-proyecto:tu-region:tu-instancia

# ============================================
# CREDENCIALES SENTINEL HUB (OPCIONAL - para filtro SAR)
# ============================================
# Obtener en: https://dataspace.copernicus.eu/
# Dashboard → User Settings → OAuth clients

SENTINELHUB_CLIENT_ID=tu-client-id-aqui
SENTINELHUB_CLIENT_SECRET=tu-client-secret-aqui